  m_Script: {fileID: 11500000, guid: 779a80b0e2b585e4a8b2216f0785c3d0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TextController
  dialogueLines:
  - "\xBFC\xF3mo te llamas, joven? "
  - "J.J. se\xF1or, \xBFQu\xE9 est\xE1 pasando aqu\xED? \xBFQui\xE9n es usted? "
  - "Me llamo Federico. Todo esto es un caos\u2026 Los personajes de algunos libros
    \r\nse han escapado, sin ellos, sus historias pierden todo el sentido. "
  - "\xBFQu\xE9? \xBFC\xF3mo ha pasado esto? "
  - "Nadie lo sabe, se han repartido por toda la ciudad. Estoy investigando lo que
    \r\nha podido pasar, pero tengo que ir tras ellos antes de que sea demasiado
    tarde. "
  - "Le ayudar\xE9, se\xF1or. "
  - "Perfecto, me vendr\xE1 bien un poco de ayuda. "
  characterName:
  - Lorca
  - J.J
  - Lorca
  - J.J
  - Lorca
  - J.J
  - Lorca
  characterSprite:
  - {fileID: 4085817070537380454, guid: cd2bb235ae887554eb98a15f68390a6f, type: 3}
