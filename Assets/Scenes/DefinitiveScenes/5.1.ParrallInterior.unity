MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1879163848}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 779a80b0e2b585e4a8b2216f0785c3d0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TextController
  dialogueLines:
  - "\xA1Mire se\xF1or Federico!\xA1Un topo! "
  - Un respeto joven.
  - "\xA1Un topo que habla! "
  - "S\xED, s\xED\u2026 lo s\xE9. Es sorprendente. "
  - "Yo tambi\xE9n me sorprend\xED la primera vez que me o\xED. "
  - "\xBFC\xF3mo te llamas?"
  - "Espera, lo ten\xEDa hace un momento\u2026 "
  - 'Federico. '
  - "\xA1No! Fonsi. "
  - "\xBFO era Ferdinand?\u2026 "
  - "\xBFFerdinand? Me suena de algo. "
  - "\xA1Claro! \xA1T\xFA eres uno de los personajes, sales en Memorias del Bosque! "
  - "\xBFUn libro? "
  - "Eso explicar\xEDa muchas cosas. "
  - "\xBFComo qu\xE9? "
  - "Como por qu\xE9 s\xE9 hablar\u2026 "
  - "O por qu\xE9 no recuerdo haber pagado nunca el alquiler de esta madriguera. "
  - 'Estoy devolviendo a todos los personajes a sus libros. '
  - "\xBFVolver a mi historia? "
  - 'Suena bien. '
  - " Igual all\xED recuerdo d\xF3nde dej\xE9 mis gafas. "
  - " \xBFUsas gafas? "
  - "No\u2026 pero seguro que perd\xED unas igualmente. "
  - Entonces necesito tu libro.
  - "S\xED, s\xED\u2026 mi libro\u2026 Memorias del bosque.. Su signatura era I-ANI
    BRU mem\u2026 creo. "
  - Introduce el nombre del autor/a
  - "\xA1Es este Ferdinand! "
  - "\xA1Bien! Sab\xEDa que esto no se me olvidar\xEDa."
  - " Parece que te est\xE1n volviendo los recuerdos. "
  - "S\xED\u2026 el bosque, mis amigos\u2026 "
  - "Y creo que tambi\xE9n record\xE9 algo importante."
  - "\xBFEl qu\xE9? "
  - " Que no deber\xEDa haberme comido ese gusano hace cinco minutos."
  - "\xBFEh? "
  - " S\xED\u2026 y creo que era mi marcap\xE1ginas. "
  - " Bueno G.G. gracias por tu ayuda, \xA1nos vemos!"
  - "Es J.J\u2026"
  characterName:
  - J.J
  - Topo
  - J.J
  - Topo
  - Topo
  - Federico
  - Topo
