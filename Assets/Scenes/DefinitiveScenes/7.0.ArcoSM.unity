  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TextController
  dialogueLines:
  - 'Siempre me han gustado las estatuas que hay en esta puerta, son muy llamativas. '
  - 'Y no es para menos J.J, esta bonita fachada fue creada en el siglo XV por Francisco
    de Colonia y Juan de Vallejo. Las bonitas estatuas de las que hablas fueron creadas
    por Ochoa de Arteaga y representan ilustres figuras como el Cid o Diego Porcelos.  '
  characterName:
  - J.J
  - Lorca
  characterSprite:
  - {fileID: 8598631743318598010, guid: 4a6e1abefffebf04e91ff0542c1032cd, type: 3}
